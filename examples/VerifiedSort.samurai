// VerifiedSort.samurai — Verified insertion sort ready for Scala 3 / TypeScript extraction
import Prelude.*
import Nat.*
import List.*
import Sorting.*

def sampleInput: List[Nat] = {
  4 :: 1 :: 3 :: 0 :: 2 :: List.Nil[Nat]
}

theorem sampleSortResult: insertionSort(sampleInput) === (0 :: 1 :: 2 :: 3 :: 4 :: List.Nil[Nat]) = by {
  decide
}

#eval insertionSort(sampleInput)
#axioms lengthInsertionSort
#axioms sampleSortResult
